rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;

      // Al publicar una resena se actualiza el promedio del perfil calificado:
      // el cliente el de la manicurista, la manicurista el del cliente.
      allow update: if request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly([
               'rating', 'reviewsCount', 'sumaCalificaciones',
               'ratingCliente', 'reviewsCountCliente',
               'sumaCalificacionesCliente',
             ]);

      match /resenas/{resenaId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null
          && request.resource.data.clienteId == request.auth.uid;
        allow update: if request.auth != null
          && request.auth.uid == userId
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['respuesta', 'respondidaEn']);
      }

      // Lo que la manicurista opina del cliente despues de atenderlo.
      match /resenasCliente/{resenaId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null
          && request.resource.data.profesionalId == request.auth.uid;
      }

      match /certificados/{certificadoId} {
        allow read: if request.auth != null;
        allow write: if request.auth != null && request.auth.uid == userId;
      }

      match /services/{serviceId} {
        allow read: if request.auth != null;
        allow write: if request.auth != null && request.auth.uid == userId;
      }

      match /disenosFavoritos/{disenoId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      match /disponibilidad/{fecha} {
        allow read: if request.auth != null;
        allow write: if request.auth != null && request.auth.uid == userId;

        // Al reservar, el cliente escribe la franja y el tramo que ocupa.
        allow create: if request.auth != null
          && request.resource.data.keys().hasOnly(['reservadas', 'ocupadas']);
        allow update: if request.auth != null
          && request.resource.data.diff(resource.data)
               .affectedKeys().hasOnly(['reservadas', 'ocupadas']);
      }
    }

    // La galeria de inspiracion consulta todos los portafolios a la vez.
    match /{ruta=**}/portfolio/{fotoId} {
      allow read: if request.auth != null;
    }

    // La clienta consulta sus resenas a traves de todas las manicuristas para
    // saber que citas ya califico.
    match /{ruta=**}/resenas/{resenaId} {
      allow read: if request.auth != null;
    }

    // La manicurista consulta a que clientes ya califico.
    match /{ruta=**}/resenasCliente/{resenaId} {
      allow read: if request.auth != null;
    }

    match /users/{userId}/portfolio/{fotoId} {
      allow write: if request.auth != null && request.auth.uid == userId;

      // Cualquier clienta autenticada puede sumar o restar el contador de favoritos.
      allow update: if request.auth != null
        && request.resource.data.diff(resource.data)
             .affectedKeys().hasOnly(['favoritos']);
    }

    // Conversacion de una cita. Solo la pueden ver y escribir las dos personas
    // que participan en ella.
    match /chats/{chatId} {
      // 'exists' antes de 'get': sobre un documento que no existe, resource y
      // get() son nulos y la regla falla con error en vez de negar limpio, lo
      // que dejaba la pantalla del chat cargando para siempre.
      function participaEnElChat() {
        return request.auth != null
          && exists(/databases/$(database)/documents/chats/$(chatId))
          && request.auth.uid in
             get(/databases/$(database)/documents/chats/$(chatId))
               .data.participantes;
      }

      allow read: if request.auth != null
        && resource != null
        && request.auth.uid in resource.data.participantes;
      allow create: if request.auth != null
        && request.auth.uid in request.resource.data.participantes;
      allow update: if request.auth != null
        && request.auth.uid in resource.data.participantes;

      match /mensajes/{mensajeId} {
        allow read: if participaEnElChat();
        allow create: if participaEnElChat()
          && request.resource.data.autorId == request.auth.uid;
      }
    }

    match /bookings/{bookingId} {
      allow read: if request.auth != null &&
        (resource.data.clientId == request.auth.uid ||
         resource.data.professionalId == request.auth.uid);
      allow create: if request.auth != null &&
        request.resource.data.clientId == request.auth.uid;
      allow update: if request.auth != null &&
        (resource.data.clientId == request.auth.uid ||
         resource.data.professionalId == request.auth.uid);

      // La direccion exacta del cliente vive aparte del documento de la cita,
      // porque las reglas protegen documentos enteros y no campos sueltos.
      // Asi la manicurista ve la zona desde que le llega la solicitud, pero la
      // puerta de la casa solo cuando ya acepto. Es la misma regla que aplica
      // al reves con la direccion de ella.
      match /privado/{documento} {
        function laCitaExiste() {
          return exists(/databases/$(database)/documents/bookings/$(bookingId));
        }

        function laCita() {
          return get(/databases/$(database)/documents/bookings/$(bookingId)).data;
        }

        allow read: if request.auth != null && laCitaExiste() && (
          laCita().clientId == request.auth.uid ||
          (laCita().professionalId == request.auth.uid &&
           laCita().status in ['confirmed', 'completed'])
        );

        // Al crear no se puede mirar la cita padre: este documento se escribe
        // en la misma transaccion que la crea, y hasta que no confirme, para
        // las reglas la cita todavia no existe. Por eso el dueño se valida con
        // el clienteId que viene en el propio documento.
        allow create: if request.auth != null &&
          request.resource.data.clienteId == request.auth.uid;

        allow update: if request.auth != null &&
          resource.data.clienteId == request.auth.uid;
      }
    }
  }
}
